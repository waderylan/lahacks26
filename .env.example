# Copy to .env and fill in. Never commit real keys.

# Vercel AI Gateway key (or set VERCEL_OIDC_TOKEN instead)
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Server port (default 5173)
PORT=5173

# Set to 1 to enable the demo scenario data
ENABLE_SCENARIO=

# Playwright: base URL and browser channel (defaults: http://localhost:5174, chrome)
RULES_TEST_URL=
RULES_BROWSER=
