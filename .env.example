# Copy to .env and fill in. Never commit real keys.

# Local model calls require a valid Vercel AI Gateway key; public hosting is retired.
AI_GATEWAY_API_KEY=

# Gemini API key: writes draft internal messages (Jev still picks the recipient)
GEMINI_API_KEY=
# Optional Gemini model override (default gemini-3.5-flash)
GEMINI_MODEL=

# Optional Qwen evaluator on an existing Veri deployment (no automatic deployment/training)
VERI_API_KEY=
VERI_DEPLOYMENT_ID=
VERI_MODEL_NAME=
# Optional runtime JSON manifest; calibration paths are relative to this manifest.
MODEL_CONFIG_FILE=
# Explicit calibration file override; runtime never discovers files in training/.
QWEN_CALIBRATION_FILE=
# Set to 1 for raw candidate scores (otherwise uses valid explicit calibration, if configured).
QWEN_RAW_SCORES=

# Server port (default 5173)
PORT=5173

# SQLite workspace file (default workspace/actions.sqlite)
WORKSPACE_DB=

# Playwright: optional external base URL and browser channel (default: isolated fixture, chrome)
RULES_TEST_URL=
RULES_BROWSER=
