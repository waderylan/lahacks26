# Copy to .env and fill in. Never commit real keys.

# Vercel AI Gateway key (or set VERCEL_OIDC_TOKEN instead)
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Gemini API key: writes draft internal messages (Jev still picks the recipient)
GEMINI_API_KEY=
# Optional Gemini model override (default gemini-3.5-flash)
GEMINI_MODEL=

# Server port (default 5173)
PORT=5173

# SQLite workspace file (default workspace/actions.sqlite)
WORKSPACE_DB=

# Playwright: optional external base URL and browser channel (default: isolated fixture, chrome)
RULES_TEST_URL=
RULES_BROWSER=
